{@extends 'oz://oz.page.layout.blate' $$}
{@slot title}{$t(oz_error_title)}{/slot}
{@slot content}
				<div class="oz-card__heading">
					<div class="oz-card__eyebrow">{$t('OZ_VIEW_ERROR_LABEL', oz_error_vars)}</div>
					<h1 class="oz-card__title">{$t(oz_error_title)}</h1>
					<p class="oz-card__text">{$t(oz_error_message, oz_error_data)}</p>
				</div>
				{@if oz_error_details}
				<div class="oz-details">
					<strong class="oz-details__label">{$t('OZ_VIEW_ERROR_DETAILS')}</strong>
					<code class="oz-details__code">{oz_error_url}</code>
					<code class="oz-details__code">{oz_error_message}</code>
				</div>
				{/if}
				<div class="oz-card__actions">
					<a class="oz-btn" href="{$global.base_url}">{$t('OZ_VIEW_GO_HOME_BTN')}</a>
					{@if oz_error_back_url}
					<a class="oz-link" href="{oz_error_back_url}">{$t('OZ_VIEW_GO_BACK_BTN')}</a>
					{/if}
				</div>
{/slot}
{/extends}
