{@extends 'oz://oz.mail.layout.html.blate' $$}
{@slot title}{$t('OZ_AUTH_2FA_SUBJECT', oz_vars, oz_locale)}{/slot}
{@slot content}
<h1 style="margin:0 0 16px 0;font-size:22px;line-height:1.3;font-weight:700;">{$t('OZ_AUTH_2FA_TITLE', oz_vars, oz_locale)}</h1>
<p style="margin:0 0 20px 0;font-size:16px;line-height:1.6;color:#3a3936;">{$t('OZ_AUTH_2FA_BODY', oz_vars, oz_locale)}</p>
<p style="margin:0 0 16px 0;"><span style="display:inline-block;background:#f6f5f2;border:1px solid #e4e1db;border-radius:10px;padding:14px 22px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:32px;font-weight:700;letter-spacing:.3em;color:#1f1e1c;">{auth_code}</span></p>
<p style="margin:0 0 20px 0;font-size:14px;line-height:1.55;color:#3a3936;">{$t('OZ_AUTH_2FA_EXPIRY', oz_vars, oz_locale)}</p>
<p style="margin:0;padding-top:16px;border-top:1px solid #e4e1db;font-size:13px;line-height:1.55;color:#5d5b57;">{$t('OZ_AUTH_2FA_NEVER_SHARE', oz_vars, oz_locale)}</p>
{/slot}
{@slot footer}{$t('OZ_MAIL_FOOTER_SIGN_IN', oz_vars, oz_locale)}{/slot}
{/extends}
