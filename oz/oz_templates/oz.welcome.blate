{@extends 'oz://oz.page.layout.blate' $$}
{@slot content}
				<div class="oz-card__heading">
					<h1 class="oz-card__title">{$global.project_name}</h1>
					<p class="oz-card__text">{$t('OZ_WELCOME_PAGE_MESSAGE')}</p>
				</div>
				<div class="oz-card__actions">
					{@if $setting('oz.api.doc', 'OZ_API_DOC_ENABLED') && $setting('oz.api.doc', 'OZ_API_DOC_SHOW_ON_INDEX')}
					<a class="oz-btn" href="{$global.base_url}/api-doc-view.html">{$t('OZ_WELCOME_PAGE_API_DOC_LINK')}</a>
					{/if}
					<span class="oz-pill">{$global.oz_version_name}</span>
				</div>
{/slot}
{@slot footer}{$t('OZ_VIEW_POWERED_BY')}{/slot}
{/extends}
