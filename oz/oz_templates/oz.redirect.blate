{@extends 'oz://oz.page.layout.blate' $$}
{@slot title}{$t('OZ_VIEW_REDIRECT_TITLE')}{/slot}
{@slot head}
		<meta http-equiv="refresh" content="0;url={oz_redirect_url}">
{/slot}
{@slot content}
				<div class="oz-card__heading">
					<h1 class="oz-card__title">{$t('OZ_VIEW_REDIRECT_TITLE')}</h1>
					<p class="oz-card__text">{$t('OZ_VIEW_REDIRECT_MESSAGE')}</p>
					<p class="oz-card__note oz-card__note--break">{oz_redirect_url}</p>
				</div>
				<div class="oz-card__actions">
					<a class="oz-btn" href="{oz_redirect_url}">{$t('OZ_VIEW_REDIRECT_LINK')}</a>
				</div>
{/slot}
{/extends}
