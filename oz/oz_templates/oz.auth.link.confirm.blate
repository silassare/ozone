{@extends 'oz://oz.page.layout.blate' $$}
{@slot title}{$t('OZ_VIEW_AUTH_LINK_CONFIRM_TITLE')}{/slot}
{@slot content}
				<div class="oz-card__heading">
					<h1 class="oz-card__title">{$t('OZ_VIEW_AUTH_LINK_CONFIRM_TITLE')}</h1>
					<p class="oz-card__text">{$t(oz_link_message, oz_vars)}</p>
				</div>
				<form class="oz-form" method="post">
					<input type="hidden" name="_csrf" value="{$global.csrf_token}">
					<button class="oz-btn oz-btn--block" type="submit">{$t('OZ_VIEW_AUTH_LINK_CONFIRM_BTN')}</button>
				</form>
				<p class="oz-card__note">{$t('OZ_VIEW_AUTH_LINK_CONFIRM_WHY')}</p>
{/slot}
{/extends}
