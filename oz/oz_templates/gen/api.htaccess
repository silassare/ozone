AddDefaultCharset UTF-8

# disable files listing, multiview and enable symbolic link
#
Options -Indexes -Multiviews +FollowSymlinks

# disable access to ozone log files
#
<Files "ozone.*\.log$">
   Order Deny,allow
   Deny from all
</Files>

# Mitigate https://httpoxy.org/ vulnerabilities
#
<IfModule mod_headers.c>
   RequestHeader unset Proxy
</IfModule>

# start rewriting
#
<IfModule mod_rewrite.c>
	RewriteEngine on

	# Authorization Header
	#
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

	# /robots.txt is OZone's route, even where a file of that name was left here.
	#
	RewriteRule ^robots\.txt$         index.php [L]

	# A file or directory that exists is served as it is (the public files behind `static`);
	# everything else is OZone's.
	#
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_URI}      !^/favicon\.ico
	RewriteRule (.*)                index.php [L]
</IfModule>
