{=$json(
  $map(
    "name", "ozone/new-project",
    "description", "A newly created project with ozone",
    "config.platform.php", oz_php_platform,
    "require.php", oz_php_constraint,
    "require['silassare/ozone']", $concat("^", $global.oz_version),
    $concat("autoload.['psr-4'].['", oz_project_namespace_escaped, "'].0"), "app",
    "['minimum-stability']", "dev",
    "['prefer-stable']", true
  ),
  0,
  true
)}
