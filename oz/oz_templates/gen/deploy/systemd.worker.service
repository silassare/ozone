# Queue workers of __PROJECT__, generated by `oz deploy init`.
#
# A template unit: one instance per worker, so they can be scaled without editing anything.
# Install as /etc/systemd/system/__UNIT__@.service, then:
#   systemctl daemon-reload && systemctl enable --now __UNIT__@1 __UNIT__@2
#
[Unit]
Description=__PROJECT__: OZone queue worker %i
After=network.target

[Service]
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PHP__ __OZ__ jobs work --queue=__QUEUE__ --sleep=3

# The worker exits on its own when it reaches its memory limit or --max-time; restarting it is the
# normal case, not a failure.
Restart=always
RestartSec=5

# A deploy swaps the release symlink: the worker has to be restarted to pick the new code up, which
# `oz deploy run` does.
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
