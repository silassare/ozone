# Timer for __UNIT__.service, generated by `oz deploy init`.
#
# Install in /etc/systemd/system/, then:
#   systemctl daemon-reload && systemctl enable --now __UNIT__.timer
#
[Unit]
Description=__PROJECT__: run the OZone cron tasks every minute

[Timer]
Unit=__UNIT__.service
OnCalendar=*:0/1
# The tasks are idempotent, but a machine that was asleep should not fire a backlog at once.
Persistent=false
AccuracySec=1s

[Install]
WantedBy=timers.target
