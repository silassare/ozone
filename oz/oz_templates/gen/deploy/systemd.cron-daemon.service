# Runs the cron tasks of __PROJECT__ from a long-running process, generated by
# `oz deploy init --cron=daemon`: `oz cron work` runs a tick at the start of every minute, where a
# timer would start `oz cron run` each minute.
#
# Install in /etc/systemd/system/, then:
#   systemctl daemon-reload && systemctl enable --now __UNIT__.service
#
[Unit]
Description=__PROJECT__: OZone cron tasks (scheduler process)
After=network.target

[Service]
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PHP__ __OZ__ cron work

# The process exits on its own when it reaches its memory limit; restarting it is the normal case,
# not a failure.
Restart=always
RestartSec=5

# A deploy swaps the release symlink: the process has to be restarted to run the new code, which
# `oz deploy run --restart` does.
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
