# Runs the due cron tasks of __PROJECT__ every minute, generated by `oz deploy init`.
#
# Install this and __UNIT__.timer in /etc/systemd/system/, then:
#   systemctl daemon-reload && systemctl enable --now __UNIT__.timer
#
[Unit]
Description=__PROJECT__: OZone cron tasks
After=network.target

[Service]
Type=oneshot
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PHP__ __OZ__ cron run
