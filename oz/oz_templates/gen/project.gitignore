# ozone
#
# Two state roots, neither of them version-controlled:
#   data/    -- must be backed up and must be consistent across instances
#   .ozone/  -- per instance, safe to delete at any time (caches, logs, build output)
#
# public/*/static are symlinks into data/static, recreated by `oz project link`.
.env
/data/
.ozone
public/static
public/*/static
**/blate_cache/*
**/ozone*.log

# cs fixer
.php-cs-fixer.cache

# composer
/vendor/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# node
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
