{@extends 'oz://oz.mail.layout.html.blate' $$}
{@slot title}{$t('OZ_AUTH_VERIFY_EMAIL_SUBJECT', oz_vars, oz_locale)}{/slot}
{@slot content}
<h1 style="margin:0 0 16px 0;font-size:22px;line-height:1.3;font-weight:700;">{$t('OZ_AUTH_VERIFY_EMAIL_TITLE', oz_vars, oz_locale)}</h1>
<p style="margin:0 0 20px 0;font-size:16px;line-height:1.6;color:#3a3936;">{$t('OZ_AUTH_VERIFY_EMAIL_BODY', oz_vars, oz_locale)}</p>
<p style="margin:0 0 20px 0;"><a href="{auth_link}" style="display:inline-block;background:{oz_mail.color};color:#ffffff;text-decoration:none;font-weight:600;font-size:16px;padding:14px 22px;border-radius:8px;">{$t('OZ_AUTH_VERIFY_EMAIL_BTN', oz_vars, oz_locale)}</a></p>
<p style="margin:0 0 20px 0;font-size:13px;line-height:1.55;color:#5d5b57;">{$t('OZ_MAIL_LINK_FALLBACK', oz_vars, oz_locale)}<br><a href="{auth_link}" style="color:{oz_mail.color};word-break:break-all;">{auth_link}</a></p>
<p style="margin:0;padding-top:16px;border-top:1px solid #e4e1db;font-size:13px;line-height:1.55;color:#5d5b57;">{$t('OZ_AUTH_VERIFY_EMAIL_IGNORE', oz_vars, oz_locale)}</p>
{/slot}
{@slot footer}{$t('OZ_MAIL_FOOTER_ADDRESS_USED', oz_vars, oz_locale)}{/slot}
{/extends}
