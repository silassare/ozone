{@extends 'oz://oz.page.layout.blate' $$}
{@slot title}{$t('OZ_ACCESS_GRANT_FORM_TITLE')}{/slot}
{@slot content}
				<div class="oz-card__heading">
					<h1 class="oz-card__title">{$t('OZ_ACCESS_GRANT_FORM_TITLE')}</h1>
					<p class="oz-card__text">{$t('OZ_ACCESS_GRANT_FORM_MESSAGE')}</p>
				</div>
				<form class="oz-form" action="{= form.action}" method="{form.method}">
					{@if form._csrf}
					<input type="hidden" name="_csrf" value="{form._csrf}">
					{/if}
					{@each field in form.fields}
					{@if field.hidden}
					<input type="hidden" name="{field.name}" value="{field.default ?? ''}">
					{:else}
					<div class="oz-form__field">
						<label class="oz-form__label" for="oz_field_{field.name}">{@if field.label}{$t(field.label)}{:else}{field.name}{/if}{@if field.required}<span class="oz-form__required" aria-hidden="true">*</span>{/if}</label>
						{@if field.password}
						<input class="oz-form__input" id="oz_field_{field.name}" type="password" name="{field.name}" autocomplete="current-password" {@if field.required}required{/if}>
						{:else}
						<input class="oz-form__input" id="oz_field_{field.name}" type="text" name="{field.name}" autocomplete="username" {@if field.required}required{/if}>
						{/if}
					</div>
					{/if}
					{/each}
					<button class="oz-btn oz-btn--block" type="submit">{$t('OZ_ACCESS_GRANT_FORM_SUBMIT_BTN')}</button>
				</form>
{/slot}
{/extends}
