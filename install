#!/usr/bin/env bash
#
# OZone installer -- puts `oz` and `ozone` on your PATH, and nothing else.
#
#   curl -fsSL https://raw.githubusercontent.com/silassare/ozone/main/install | bash
#
# By default it installs nothing system-wide: it checks that PHP and the tools OZone needs are
# present and tells you what to install if they are not. Preparing a server (web server, database,
# firewall) is `oz server provision`, not this script's job.
#
#   --with-php        also install PHP, its extensions, Composer and git (needs root)
#   --version=<tag>   install this release instead of the latest
#   --system          install to /opt/ozone and /usr/local/bin (needs root)
#   --uninstall       remove what this script installed
#   --help
#
set -euo pipefail

REPO_RAW="https://raw.githubusercontent.com/silassare/ozone"
REPO_GIT="https://github.com/silassare/ozone.git"
BRANCH="main"

OZONE_HOME="${OZONE_HOME:-$HOME/.ozone/tool}"
OZONE_BIN="${OZONE_BIN:-$HOME/.local/bin}"
MIN_PHP="8.1"

WITH_PHP=0
SYSTEM=0
UNINSTALL=0
VERSION=""

# = Output

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
	C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
else
	C_RED=""; C_GREEN=""; C_YELLOW=""; C_DIM=""; C_OFF=""
fi

say()  { printf '%s\n' "$*"; }
info() { printf '%s%s%s\n' "$C_DIM" "$*" "$C_OFF"; }
warn() { printf '%s%s%s\n' "$C_YELLOW" "$*" "$C_OFF" >&2; }
ok()   { printf '%s%s%s\n' "$C_GREEN" "$*" "$C_OFF"; }
die()  { printf '%s%s%s\n' "$C_RED" "$*" "$C_OFF" >&2; exit 1; }

has() { command -v "$1" >/dev/null 2>&1; }

# = Arguments

for arg in "$@"; do
	case "$arg" in
		--with-php) WITH_PHP=1 ;;
		--system) SYSTEM=1 ;;
		--uninstall) UNINSTALL=1 ;;
		--version=*) VERSION="${arg#*=}" ;;
		--help|-h)
			awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
			exit 0
			;;
		*) die "Unknown option: $arg (try --help)" ;;
	esac
done

if [ "$SYSTEM" -eq 1 ]; then
	OZONE_HOME="${OZONE_HOME_SYSTEM:-/opt/ozone/tool}"
	OZONE_BIN="${OZONE_BIN_SYSTEM:-/usr/local/bin}"
fi

need_root() {
	if [ "$(id -u)" -ne 0 ]; then
		die "$1 needs root. Re-run with sudo, or drop the flag."
	fi
}

# = Platform

detect_pm() {
	if has apt-get; then echo apt
	elif has dnf; then echo dnf
	elif has yum; then echo yum
	elif has pacman; then echo pacman
	elif has apk; then echo apk
	elif has brew; then echo brew
	else echo unknown
	fi
}

PM="$(detect_pm)"

# The package that provides a PHP extension, per package manager. Extension names come from
# `composer.json`, so this map only has to cover what OZone actually requires.
php_ext_package() {
	local ext="$1"
	case "$PM" in
		apt) echo "php-$ext" ;;
		dnf|yum) echo "php-$ext" ;;
		pacman)
			case "$ext" in
				pdo|json|posix|libxml|simplexml|fileinfo|openssl) echo "php" ;;
				*) echo "php-$ext" ;;
			esac
			;;
		apk) echo "php-$ext" ;;
		brew) echo "php" ;;
		*) echo "php-$ext" ;;
	esac
}

install_hint() {
	local packages="$1"
	case "$PM" in
		apt) echo "sudo apt-get update && sudo apt-get install -y $packages" ;;
		dnf) echo "sudo dnf install -y $packages" ;;
		yum) echo "sudo yum install -y $packages" ;;
		pacman) echo "sudo pacman -S --needed $packages" ;;
		apk) echo "sudo apk add $packages" ;;
		brew) echo "brew install $packages" ;;
		*) echo "install: $packages" ;;
	esac
}

pm_install() {
	case "$PM" in
		apt) DEBIAN_FRONTEND=noninteractive apt-get -qq update && DEBIAN_FRONTEND=noninteractive apt-get -qq install -y "$@" ;;
		dnf) dnf install -y -q "$@" ;;
		yum) yum install -y -q "$@" ;;
		pacman) pacman -S --needed --noconfirm "$@" ;;
		apk) apk add --quiet "$@" ;;
		brew) brew install "$@" ;;
		*) die "No supported package manager found; install these yourself: $*" ;;
	esac
}

# = Requirements
#
# The extension list is read from the installed OZone's composer.json when there is one, so it
# cannot drift from what the framework declares. Before the first install we have no checkout, so
# this fallback is used -- `oz doctor` is authoritative afterwards.
FALLBACK_EXTS="pdo openssl json gd libxml simplexml posix bcmath fileinfo mbstring"

required_extensions() {
	local composer_json="$OZONE_HOME/composer.json"

	if [ -f "$composer_json" ] && has php; then
		php -r '
			$d = json_decode(file_get_contents($argv[1]), true);
			$out = [];
			foreach (array_keys($d["require"] ?? []) as $p) {
				if (str_starts_with($p, "ext-")) { $out[] = substr($p, 4); }
			}
			echo implode(" ", $out);
		' "$composer_json" 2>/dev/null || echo "$FALLBACK_EXTS"
	else
		echo "$FALLBACK_EXTS"
	fi
}

php_ok() {
	has php && php -r 'exit(version_compare(PHP_VERSION, $argv[1], ">=") ? 0 : 1);' "$MIN_PHP" 2>/dev/null
}

missing_extensions() {
	local missing=""
	for ext in $(required_extensions); do
		if ! php -r 'exit(extension_loaded($argv[1]) ? 0 : 1);' "$ext" 2>/dev/null; then
			missing="$missing $ext"
		fi
	done
	echo "${missing# }"
}

check_requirements() {
	local problems=0 packages=""

	if ! has php; then
		warn "PHP is not installed."
		packages="$packages php-cli"
		problems=1
	elif ! php_ok; then
		warn "PHP $(php -r 'echo PHP_VERSION;') is too old; OZone needs $MIN_PHP or newer."
		problems=1
	else
		local missing
		missing="$(missing_extensions)"
		if [ -n "$missing" ]; then
			warn "Missing PHP extensions:$(printf ' %s' $missing)"
			for ext in $missing; do
				packages="$packages $(php_ext_package "$ext")"
			done
			problems=1
		fi
	fi

	has composer || { warn "Composer is not installed."; packages="$packages composer"; problems=1; }
	has git || { warn "git is not installed."; packages="$packages git"; problems=1; }

	if [ "$problems" -eq 1 ]; then
		packages="$(echo $packages | tr ' ' '\n' | sort -u | tr '\n' ' ')"
		say ""
		say "Install them with:"
		say "  $(install_hint "${packages% }")"
		say ""
		say "Or re-run this script with --with-php to let it do that for you."
		return 1
	fi

	return 0
}

install_requirements() {
	need_root "--with-php"

	[ "$PM" = "unknown" ] && die "No supported package manager found. Install PHP $MIN_PHP+, Composer and git yourself."

	info "Installing PHP and the tools OZone needs ($PM)..."

	local packages="php-cli git"
	for ext in $FALLBACK_EXTS; do
		packages="$packages $(php_ext_package "$ext")"
	done

	# shellcheck disable=SC2086
	pm_install $(echo $packages | tr ' ' '\n' | sort -u | tr '\n' ' ')

	if ! has composer; then
		info "Installing Composer..."
		local tmp
		tmp="$(mktemp -d)"
		php -r "copy('https://getcomposer.org/installer', '$tmp/composer-setup.php');"
		php "$tmp/composer-setup.php" --quiet --install-dir=/usr/local/bin --filename=composer
		rm -rf "$tmp"
	fi
}

# = Install

latest_version() {
	local v
	v="$(curl -fsSL "$REPO_RAW/$BRANCH/VERSION" 2>/dev/null | tr -cd '0-9.')"
	[ -n "$v" ] || die "Unable to read the latest OZone version from $REPO_RAW/$BRANCH/VERSION."
	echo "$v"
}

write_shim() {
	local target="$1"

	cat > "$target" <<'SHIM'
#!/usr/bin/env bash
# OZone CLI shim. Prefers the project's own oz when the working directory is a project, so a
# project always runs the OZone version it depends on.
set -euo pipefail
GLOBAL_OZ="__OZONE_HOME__/bin/oz"
if [ -f "$PWD/vendor/bin/oz" ] && [ -f "$PWD/app/app.php" ]; then
	exec "$PWD/vendor/bin/oz" "$@"
fi
exec "$GLOBAL_OZ" "$@"
SHIM

	sed -i.bak "s|__OZONE_HOME__|$OZONE_HOME|g" "$target" && rm -f "$target.bak"
	chmod 0755 "$target"
}

do_uninstall() {
	for name in oz ozone; do
		if [ -f "$OZONE_BIN/$name" ] && grep -q "OZone CLI shim" "$OZONE_BIN/$name" 2>/dev/null; then
			rm -f "$OZONE_BIN/$name"
			info "Removed $OZONE_BIN/$name"
		fi
	done

	if [ -d "$OZONE_HOME" ]; then
		rm -rf "$OZONE_HOME"
		info "Removed $OZONE_HOME"
	fi

	ok "OZone removed. Your projects and their vendor/bin/oz are untouched."
}

do_install() {
	has curl || die "curl is required to install OZone."
	has git || die "git is required to install OZone."

	check_requirements || die "Requirements are not met; nothing was installed."

	local version="${VERSION:-$(latest_version)}"
	local tag="v$version"

	mkdir -p "$OZONE_HOME" "$OZONE_BIN"

	if [ -d "$OZONE_HOME/.git" ]; then
		info "Updating OZone in $OZONE_HOME to $tag..."
		git -C "$OZONE_HOME" fetch --depth 1 --force origin "refs/tags/$tag:refs/tags/$tag" >/dev/null 2>&1 \
			|| die "No such OZone release: $tag"
		git -C "$OZONE_HOME" checkout -q "$tag" || die "Unable to check out $tag; is $OZONE_HOME modified?"
	else
		info "Downloading OZone $tag..."
		git clone -q --depth 1 --branch "$tag" "$REPO_GIT" "$OZONE_HOME" \
			|| die "Unable to download OZone $tag from $REPO_GIT."
	fi

	info "Installing dependencies..."
	(cd "$OZONE_HOME" && composer install --no-interaction --no-progress --quiet)

	write_shim "$OZONE_BIN/oz"
	cp "$OZONE_BIN/oz" "$OZONE_BIN/ozone"
	chmod 0755 "$OZONE_BIN/ozone"

	ok "OZone $version installed in $OZONE_HOME."
	say ""

	case ":$PATH:" in
		*":$OZONE_BIN:"*) ;;
		*)
			warn "$OZONE_BIN is not on your PATH. Add it:"
			say "  echo 'export PATH=\"$OZONE_BIN:\$PATH\"' >> ~/.profile && . ~/.profile"
			say ""
			;;
	esac

	say "Next:"
	say "  oz doctor check          # verify this machine"
	say "  oz project create --help # start a project"
	say "  oz server provision      # prepare a server that will not run Docker"
}

if [ "$UNINSTALL" -eq 1 ]; then
	do_uninstall
	exit 0
fi

[ "$WITH_PHP" -eq 1 ] && install_requirements

do_install
