<?xml version="1.0" encoding="UTF-8"?>

<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/autoload.php"
         failOnRisky="true"
         failOnWarning="true">

    <php>
        <ini name="error_reporting" value="-1"/>
        <!--
            No server address belongs in this file. The suites run through `make`, in Docker, and
            docker/compose.yaml exports every OZ_TEST_* / OZ_REDIS_* / OZ_MINIO_* / OZ_CLAMAV_*
            variable into the PHP container. A developer who does not want Docker exports the same
            variables themselves; do NOT copy this file to phpunit.xml, which PHPUnit would then
            prefer over it (see CONTRIBUTING.md).

            The integration suite runs on SQLite, MySQL and PostgreSQL, and fails when MySQL or
            PostgreSQL is not configured. Set OZ_TEST_ALLOW_PARTIAL=1 to run on the drivers that
            are configured, and only then.
        -->
    </php>

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/</directory>
            <exclude>tests/Integration</exclude>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration/</directory>
        </testsuite>
    </testsuites>

    <!--
        Need a server or a throwaway container: `make test-services` runs redis / minio / clamav,
        `make test-runtimes` runs frankenphp / roadrunner / swoole, `make test-provision` runs
        provision. All fail instead of skipping when what they need is missing.
    -->
    <groups>
        <exclude>
            <group>redis</group>
            <group>minio</group>
            <group>clamav</group>
            <group>frankenphp</group>
            <group>roadrunner</group>
            <group>swoole</group>
            <group>provision</group>
        </exclude>
    </groups>

    <coverage processUncoveredFiles="false">
        <include>
            <directory suffix=".php">oz</directory>
        </include>
        <exclude>
            <directory>oz/Db</directory>
            <directory>oz/oz_default</directory>
            <directory>oz/oz_settings</directory>
            <directory>oz/oz_templates</directory>
        </exclude>
    </coverage>
</phpunit>
